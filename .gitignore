# ROMs: players supply their own
*.z64
*.n64
*.v64

# Code recompiled from the ROM (tools/regen.py): derived from the game, never committed
gen/
RecompiledFuncs*/
rsp/aspMain_*.cpp

# Build output
build/
build-*/
build-farm/
*.exe
*.pdb
*.map

# Local working files: logs, captures, old trees, fetched toolkits, launchers Setup makes
scratch/
logs/
deps/
*.log
* (recomp).cmd
* (recomp).sh
* (recomp).command

# setup-builds (Docker): the results; the containers' build folders are build-* above
builds/

# Written in the working folder on first run: settings, saves, the runtime's mod folders
rampage.json
rampage2.json
saves/
mods/
mod_config/
mods.json*
texture-packs/

# Python
__pycache__/
*.pyc

# IDE / OS
.vscode/
.idea/
*.suo
*.user
Thumbs.db
.DS_Store
desktop.ini
